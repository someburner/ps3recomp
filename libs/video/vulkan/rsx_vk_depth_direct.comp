#version 450
layout(local_size_x=8,local_size_y=8,local_size_x_id=0,local_size_y_id=1) in;
layout(set=0,binding=0) uniform sampler2D depth_image;
layout(set=0,binding=1,rgba8) writeonly uniform image2D color_image;
layout(push_constant) uniform Params { uint width; uint height; } p;

// For d=m*2^(e-150), round(d*(2^24-1)) is a half-down shift
// of m for e<126. At e=126 subtract one, except at exactly 0.5.
// This is exact for every binary32 input; no wide multiply is needed.
uint quantize(uint raw) {
    float d=uintBitsToFloat(raw);
    if (!(d>0.0)) return 0;
    if (d>=1.0) return 0xffffffu;
    uint e=(raw>>23)&255u;
    if (e<102u) return 0;
    uint m=(raw&0x7fffffu)|0x800000u;
    if(e==126u) return m-uint(m!=0x800000u);
    uint k=126u-e;
    return (m+((1u<<(k-1u))-1u))>>k;
}
void main() {
    uvec2 pos=gl_GlobalInvocationID.xy;
    if(pos.x>=p.width || pos.y>=p.height) return;
    uint v=quantize(floatBitsToUint(texelFetch(depth_image,ivec2(pos),0).r));
    imageStore(color_image,ivec2(pos),vec4((v>>8)&255u,v&255u,0u,v>>16)/255.0);
}
